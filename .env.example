# Copy to .env for local runs. Never commit .env or place secrets under dist/.
# For GitHub Actions use repository Settings > Secrets and variables > Actions instead.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
# Include /v1 in BASE_URL when required by your provider. No /chat/completions suffix.
# Missing any one field safely skips model calls while retaining collection.
SCHEDULE_ENABLED=true
